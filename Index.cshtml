@model CareerRecommendationSystem.Models.CareerAssessment

@{
    ViewData["Title"] = "Career Assessment";
}

<div class="assessment-page">

    <!-- Welcome Section -->
    <section class="assessment-hero">
        <div>
            <span class="hero-tag">AI POWERED CAREER GUIDANCE</span>

            <h1>Discover Your Perfect Career Path</h1>

            <p>
                Understand your strengths, explore your interests,
                and discover career opportunities with AI-powered
                recommendations.
            </p>
        </div>

        <div class="hero-icon">
            <span>🎓</span>
        </div>
    </section>

    <!-- Assessment Form -->
    <section class="assessment-card">

        <div class="form-heading">
            <div class="heading-icon">📋</div>

            <div>
                <h2>Student Career Assessment</h2>
                <p>
                    Complete the information below to get your recommendations.
                </p>
            </div>
        </div>

        <div class="form-progress">
            <div class="progress-label">
                <span>Assessment Form</span>
                <span>Complete all fields</span>
            </div>

            <div class="progress-track">
                <div class="progress-fill"></div>
            </div>
        </div>

        <!-- IMPORTANT: Submit to Recommend -->
        <form asp-controller="Career"
              asp-action="Recommend"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <!-- Personal Information -->
            <div class="form-section">

                <h3>
                    <span>👤</span> Personal Information
                </h3>

                <div class="form-grid">

                    <div class="form-group">
                        <label asp-for="FullName">Full Name</label>

                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Enter your full name" />

                        <span asp-validation-for="FullName"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email">Email Address</label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="Enter your email" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Age">Age</label>

                        <input asp-for="Age"
                               type="number"
                               min="15"
                               max="70"
                               class="form-control"
                               placeholder="Enter your age" />

                        <span asp-validation-for="Age"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Percentage">
                            Academic Percentage
                        </label>

                        <input asp-for="Percentage"
                               type="number"
                               min="0"
                               max="100"
                               step="0.01"
                               class="form-control"
                               placeholder="Enter percentage (0-100)" />

                        <span asp-validation-for="Percentage"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>

            <!-- Skills -->
            <div class="form-section">

                <h3>
                    <span>💡</span> Skills Assessment
                </h3>

                <p class="section-description">
                    Rate your current skills from 0 to 100.
                </p>

                <div class="form-grid">

                    <div class="form-group">
                        <label asp-for="ProgrammingSkill">
                            Programming Skills
                        </label>

                        <input asp-for="ProgrammingSkill"
                               type="number"
                               min="0"
                               max="100"
                               class="form-control"
                               placeholder="Example: 85" />

                        <span asp-validation-for="ProgrammingSkill"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CommunicationSkill">
                            Communication Skills
                        </label>

                        <input asp-for="CommunicationSkill"
                               type="number"
                               min="0"
                               max="100"
                               class="form-control"
                               placeholder="Example: 75" />

                        <span asp-validation-for="CommunicationSkill"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MathSkill">
                            Mathematical Skills
                        </label>

                        <input asp-for="MathSkill"
                               type="number"
                               min="0"
                               max="100"
                               class="form-control"
                               placeholder="Example: 90" />

                        <span asp-validation-for="MathSkill"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>

            <!-- Career Preferences -->
            <div class="form-section">

                <h3>
                    <span>🎯</span> Career Preferences
                </h3>

                <div class="form-grid">

                    <div class="form-group">
                        <label asp-for="Interest">
                            Area of Interest
                        </label>

                        <select asp-for="Interest"
                                class="form-select">

                            <option value="">Select your interest</option>
                            <option value="Technology">Technology</option>
                            <option value="Data Science">Data Science</option>
                            <option value="Science">Science</option>
                            <option value="Design">Design</option>
                            <option value="Business">Business</option>
                            <option value="Finance">Finance</option>
                            <option value="Education">Education</option>

                        </select>

                        <span asp-validation-for="Interest"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="WorkPreference">
                            Preferred Work Environment
                        </label>

                        <select asp-for="WorkPreference"
                                class="form-select">

                            <option value="">Select your preference</option>
                            <option value="Remote">Remote</option>
                            <option value="On-site">On-site</option>
                            <option value="Hybrid">Hybrid</option>

                        </select>

                        <span asp-validation-for="WorkPreference"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>

            <!-- Submit Button -->
            <div class="form-submit">

                <p>
                    ✨ Your information will help generate
                    personalized career recommendations.
                </p>

                <button type="submit" class="recommend-btn">
                    Get Career Recommendations
                    <span>→</span>
                </button>

            </div>

        </form>

    </section>

    <!-- Bottom Information -->
    <section class="assessment-info">

        <div class="info-item">
            <span>🤖</span>
            <div>
                <h4>AI Powered</h4>
                <p>Intelligent career matching</p>
            </div>
        </div>

        <div class="info-item">
            <span>🎯</span>
            <div>
                <h4>Personalized</h4>
                <p>Based on your skills and interests</p>
            </div>
        </div>

        <div class="info-item">
            <span>🚀</span>
            <div>
                <h4>Future Ready</h4>
                <p>Explore suitable career paths</p>
            </div>
        </div>

    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
